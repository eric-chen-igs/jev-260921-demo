# OpenRouter API key. Get one at https://openrouter.ai/keys
# The app can also take this via the sidebar, so this file is optional.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: override the Jev model slug served by OpenRouter's Decisions endpoint.
# Pinned by default rather than using the moving `typesafe/jev-latest` alias,
# because every threshold in the ten demos was tuned against 1.13.
JEV_MODEL=typesafe/jev-1.13

# Optional: default LLM used for the side-by-side comparison.
# Defaults to a model available in Hong Kong; see the README on regional
# availability before switching this to an OpenAI or Anthropic slug.
COMPARE_LLM_MODEL=google/gemini-3.8-flash
